{
  "compilerOptions": {
    "target": "ES2017",
    "module": "ESNext",
    "moduleResolution": "node",
    "jsx": "react",
    "lib": ["ES2017", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": true,
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": false,
    "baseUrl": ".",
    "paths": {
      "@microsoft/sp-webpart-base": ["./src/lib/spShim.ts"],
      "@microsoft/sp-http": ["./src/lib/spShim.ts"],
      "@microsoft/sp-core-library": ["./src/lib/spShim.ts"],
      "@microsoft/sp-component-base": ["./src/lib/spShim.ts"],
      "@microsoft/sp-property-pane": ["./src/lib/spShim.ts"]
    },
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "jest",
      "node"
    ]
  },
  "include": ["src", "vite.config.ts"]
}
